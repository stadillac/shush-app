# Copy this file to `local.properties` (gitignored) in this same folder and
# fill in real values. Android Studio will also append `sdk.dir` here
# automatically the first time you open the project.

sdk.dir=/path/to/Android/sdk

# Same project as the web app's .env.local — NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY. The anon key is safe to ship in the app;
# access is still scoped by Supabase Row Level Security + the signed-in
# user's own token.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
